# ───────────────────────────────────────────────────────────────
# .env  — checked-in template, copied to .env on dev machines.
# ───────────────────────────────────────────────────────────────
# IMPORTANT: keep .env pointed at STAGING for safety. Production is
# configured via Cloudflare Pages env vars, NOT this file.
#
# `npm run dev` reads .env.local first (gitignored) then .env. So:
#   - .env.local  → your overrides (typically NOT needed; staging is fine)
#   - .env        → staging URL/key as the safe default
#
# `src/lib/supabase.js` will refuse to start on localhost if it detects
# a production Supabase URL, unless you set:
#   VITE_ALLOW_LOCALHOST_PROD=yes
# That escape hatch should be rare — local writes against prod were
# responsible for a real data-loss incident.

VITE_SUPABASE_URL=https://hdnavfdmadciihsgscmq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-staging-publishable-key-here

# Optional legacy fallback (only if you don't have the new publishable key)
VITE_SUPABASE_ANON_KEY=optional-legacy-anon-key-here

# DANGER — set this only when you genuinely need to debug against prod
# from your local machine. Default off.
# VITE_ALLOW_LOCALHOST_PROD=yes
