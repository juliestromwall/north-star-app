# Allow northstarsurrogacy.com and its subdomains to embed the public intake flow.
# Other origins (including unknown marketing partners) cannot frame these pages.

/getstarted
  Content-Security-Policy: frame-ancestors 'self' https://northstarsurrogacy.com https://*.northstarsurrogacy.com

/getstarted/surrogate
  Content-Security-Policy: frame-ancestors 'self' https://northstarsurrogacy.com https://*.northstarsurrogacy.com

/getstarted/intendedparent
  Content-Security-Policy: frame-ancestors 'self' https://northstarsurrogacy.com https://*.northstarsurrogacy.com

/getstarted/confirmation
  Content-Security-Policy: frame-ancestors 'self' https://northstarsurrogacy.com https://*.northstarsurrogacy.com
